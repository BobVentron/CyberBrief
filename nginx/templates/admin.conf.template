server {
    listen 80;
    server_name _;
    charset utf-8;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control "no-store" always;

    location = / { try_files /admin.html =404; }
    location = /admin.html { add_header Cache-Control "no-store, no-cache" always; }

    location /js/ {
        alias /usr/share/nginx/html/js/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://cyberbrief-api:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Admin-Token ${ADMIN_API_TOKEN};
    }

    location ~ /\. { deny all; return 404; }
    access_log /var/log/nginx/admin.access.log;
    error_log /var/log/nginx/admin.error.log warn;
}
