# Image du site public CyberBrief — fichiers statiques copiés dans l'image
# (élimine le bug de bind-mount sur inode périmé à chaque redéploiement)
FROM nginx:alpine

# Config nginx (zones de rate-limit + server block)
COPY nginx.conf   /etc/nginx/nginx.conf
COPY default.conf /etc/nginx/conf.d/default.conf

# Contenu statique
COPY index.html   /usr/share/nginx/html/index.html
COPY pages/       /usr/share/nginx/html/pages/

# Les rapports sont montés au runtime (générés par le daemon)
RUN mkdir -p /usr/share/nginx/html/reports

EXPOSE 80
