// prisma/schema.prisma — CyberBrief v2
// PostgreSQL — toutes les tables : users, sessions, mail_preferences, audit_log

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(false) @map("is_active")   // Email vérifié
  isAdmin      Boolean  @default(false) @map("is_admin")

  // RGPD
  consentGivenAt      DateTime? @map("consent_given_at")
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  lastLoginAt         DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  sessions    UserSession[]
  preferences MailPreference?
  tokens      VerificationToken[]

  @@map("users")
}

// ── Sessions (refresh tokens) ─────────────────────────────────────────────────

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")  // SHA-256, jamais le token brut
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ── Mail Preferences ──────────────────────────────────────────────────────────

model MailPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  recipientEmails String[] @map("recipient_emails")  // Array PostgreSQL natif
  sendDaily       Boolean  @default(true)  @map("send_daily")
  sendWeekly      Boolean  @default(true)  @map("send_weekly")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mail_preferences")
}

// ── Verification Tokens ───────────────────────────────────────────────────────

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  purpose   String   // "email_verify" | "password_reset"
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

// ── Audit Log (RGPD + NIS-2) ─────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?  @map("user_id")    // Nullable — anonymisé à la suppression du compte
  action    String                       // "login", "register", "delete_account"…
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   Json?                        // Données contextuelles optionnelles
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Mail Send Log ─────────────────────────────────────────────────────────────

model MailSendLog {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  recipient  String
  reportFile String   @map("report_file")
  reportType String   @map("report_type")  // "daily" | "weekly"
  status     String                         // "sent" | "failed"
  error      String?
  sentAt     DateTime @default(now()) @map("sent_at")

  @@index([userId])
  @@map("mail_send_logs")
}

// ── Settings (config dynamique) ──────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ── Claude API Usage Log ──────────────────────────────────────────────────────

model ApiUsageLog {
  id             Int      @id @default(autoincrement())
  reportFile     String   @map("report_file")
  reportType     String   @map("report_type")    // "daily" | "weekly"
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  totalTokens    Int      @map("total_tokens")
  costUsd        Float    @map("cost_usd")        // Coût calculé en USD
  modelUsed      String   @map("model_used")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("api_usage_logs")
}
