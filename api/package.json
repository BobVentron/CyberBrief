{
  "name": "cyberbrief-api",
  "version": "2.0.0",
  "description": "CyberBrief API — Auth, Users, Mail, Admin",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start":     "node src/app.js",
