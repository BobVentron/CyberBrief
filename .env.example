# ── Base de données ───────────────────────────────────
DB_HOST=cyberbrief-db
DB_PORT=5432
DB_NAME=cyberbrief
DB_USER=cyberbrief
DB_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://cyberbrief:CHANGE_ME@cyberbrief-db:5432/cyberbrief

# ── API ───────────────────────────────────────────────
NODE_ENV=production
PORT=8000
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING

# ── Tokens internes ───────────────────────────────────
INTERNAL_API_TOKEN=CHANGE_ME
ADMIN_API_TOKEN=CHANGE_ME

# ── Claude AI ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME
CLAUDE_MODEL=claude-sonnet-4-6

# ── SMTP ──────────────────────────────────────────────
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=votre@email.com

# ── URLs ──────────────────────────────────────────────
CYBERBRIEF_API_URL=http://cyberbrief-api:8000
REPORT_BASE_URL=https://votre-domaine.com

# ── Rapports ──────────────────────────────────────────
REPORTS_DIR=/app/reports

# ── Gotify (optionnel) ────────────────────────────────
GOTIFY_URL=
GOTIFY_APP_TOKEN=

# ── Timezone ──────────────────────────────────────────
TZ=Europe/Paris
